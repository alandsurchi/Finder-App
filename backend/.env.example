# Copy to .env (loaded automatically by server.js). Existing process env wins.

# development | production. Production refuses to start without a real JWT_SECRET.
NODE_ENV=development

# Port the API listens on. The Flutter app defaults to http://localhost:3001 in debug builds.
PORT=3001

# Public https URL of this API once deployed (used for demo image links).
PUBLIC_URL=http://localhost:3001

# Secret used to sign JWTs. Required in production, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated browser origins allowed to call the API (web build, admin page).
# Leave empty in development to allow every origin.
CORS_ORIGINS=

# Leave empty to use the local SQLite file (backend/database.sqlite).
# Set a postgres:// URL to use PostgreSQL (Railway, Render, Neon, docker compose).
DATABASE_URL=

# Outgoing e-mail for verification and password-reset codes.
# When nothing below is set the backend runs in demo mode: signups are verified
# immediately and any code is accepted; reset codes are printed to the console.
# Preferred: Resend over HTTPS (works on hosts that block SMTP ports, e.g. Railway trial/hobby):
#   RESEND_API_KEY=re_xxx   (or SMTP_HOST=smtp.resend.com with SMTP_PASS=re_xxx, which is detected)
# Any other provider: plain SMTP through SMTP_HOST/PORT/USER/PASS.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Directory for uploaded images. In production mount a persistent volume and point this at it.
UPLOADS_DIR=./uploads

# Optional tuning
RATE_LIMIT_GENERAL=600
RATE_LIMIT_AUTH=30
RATE_LIMIT_RESET=5
SUPPORT_EMAIL=support@finder.app

# Base URL used by `npm run seed` for demo image links.
# On an Android emulator use http://10.0.2.2:3001
SEED_PUBLIC_URL=http://localhost:3001
