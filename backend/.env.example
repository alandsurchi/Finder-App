# Copy to .env (loaded automatically by server.js). Existing process env wins.

# Port the API listens on. The Flutter app defaults to http://localhost:3001.
PORT=3001

# Secret used to sign JWTs. Set a long random string in any real deployment.
JWT_SECRET=

# Leave empty to use the local SQLite file (backend/database.sqlite).
# Set a postgres:// URL to use PostgreSQL (e.g. on Railway).
DATABASE_URL=

# Outgoing e-mail for verification and password-reset codes.
# When these are empty the backend runs in demo mode: signups are verified
# immediately and any code is accepted; reset codes are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Base URL used by `npm run seed` for demo image links.
# On an Android emulator use http://10.0.2.2:3001
SEED_PUBLIC_URL=http://localhost:3001
