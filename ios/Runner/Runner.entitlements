<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). Needs an Apple Developer Program team; the
	     unsigned sideload build ignores entitlements. Xcode switches this to
	     "production" automatically for App Store / TestFlight archives. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
